option('native_llvm_path', type : 'string', value: '/usr/local/opt/llvm@15')
option('build_airconv_for_windows', type : 'boolean', value : false)
option('dxmt_debug', type : 'boolean', value : false)
option('dxmt_native', type : 'boolean', value : false, deprecated : true)
option('wine_build_path', type : 'string')
option('wine_install_path', type : 'string')
option('wine_builtin_dll', type : 'boolean', value : true)
option('enable_tests', type : 'boolean', value : false)
option('enable_nvapi', type : 'boolean', value : false)
option('enable_nvngx', type : 'boolean', value : false)
option('enable_d3d12', type : 'boolean', value : false)
option('vibewine_scene_submission', type : 'boolean', value : false,
  description : 'Experimental admission-preserving scene submission before drawable acquisition')
option('vibewine_precise_bindings', type : 'boolean', value : false)
option('vibewine_dead_attachment_stores', type : 'boolean', value : false)
option('vibewine_physical_residency_dedup', type : 'boolean', value : false)
option('vibewine_residency_sets', type : 'boolean', value : false)
option('vibewine_idle_retirement', type : 'boolean', value : false)
option('vibewine_fixed_output_metalfx', type : 'boolean', value : false)
option('vibewine_shader_cleanup', type : 'boolean', value : false)
option('vibewine_demand_scheduler', type : 'boolean', value : false,
  description : 'Experimental bounded demand-aware shader compiler scheduling')
option('vibewine_discard_hints', type : 'boolean', value : false,
  description : 'Experimental exact full-color discard store admission')
option('vibewine_bounded_encoder_optimizer', type : 'boolean', value : false,
  description : 'Experimental 64-position encoder merge lookahead; off preserves unbounded search')
option('vibewine_packed_ir_growth', type : 'boolean', value : false,
  description : 'Experimental 1.5x packed shader IR allocation growth; retains extra bounded slack')
option('vibewine_perf_reference', type : 'combo', choices : ['none', 'w4', 'getters', 'batching'], value : 'none',
  description : 'Build-only corrected W4 performance reference; none keeps all optimizations')

option('vibewine_render_pass_fusion', type : 'boolean', value : false,
       description : 'Join ordinary render setup and recorded commands in one native call')

option('vibewine_compute_pass_fusion', type : 'boolean', value : false,
       description : 'Join compute setup and recorded commands in one native call')

option('vibewine_native_raster_shadow', type : 'boolean', value : false,
  description : 'Experimental per-decoder raster selector shadow; change-heavy workloads can regress')

option('vibewine_semantic_blend_hash', type : 'boolean', value : false,
  description : 'Experimental graphics PSO semantic blend hash with one cached word per blend state')

option('vibewine_marshal_packets', type : 'boolean', value : false,
  description : 'Experimental fixed GS/TS preparation and residency packets')

option('vibewine_empty_color_slots', type : 'boolean', value : false,
  description : 'Experimental canonical empty color attachment descriptor suppression')

option('vibewine_initializer_inclusive_reuse', type : 'boolean', value : false,
  description : 'Experimental initializer-only upload reuse at inclusive completion equality')
