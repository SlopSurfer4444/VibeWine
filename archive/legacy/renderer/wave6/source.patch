+  auto matches = [&](LONG_PTR s, LONG_PTR e, const RECT &r) {
+    LONG_PTR actual_s, actual_e; RECT actual;
+    return IsWindow(window) && read(GWL_STYLE, actual_s) && read(GWL_EXSTYLE, actual_e) &&
