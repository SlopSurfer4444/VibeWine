+/* Render dimensions are captured before SetWindowPos can dispatch WM_SIZE.
+ * The caller publishes buffer state only after a successful window request. */
+inline DS3BorderlessResult prepareDS3Borderless(HWND window, bool windowed, uint32_t &width, uint32_t &height, uint32_t previous_width = 0, uint32_t previous_height = 0) {
+  if (!windowed || !ds3BorderlessEnabled()) return DS3BorderlessResult::Disabled;
+  uint32_t render_width = width, render_height = height;
+  if (!width || !height) {
+    if (windowed && ds3BorderlessEnabled() && previous_width && previous_height) {
+      render_width = previous_width;
+      render_height = previous_height;
+    } else {
+      RECT client = {};
+      if (!GetClientRect(window, &client)) return DS3BorderlessResult::Refused;
+      render_width = client.right - client.left;
+      render_height = client.bottom - client.top;
+    }
+  }
+  auto result = applyDS3Borderless(window, windowed);
+  if (result == DS3BorderlessResult::Disabled || result == DS3BorderlessResult::Applied || result == DS3BorderlessResult::Unchanged) {
+    width = render_width;
+    height = render_height;
+  }
+  return result;
+}
