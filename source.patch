+    if (node.role == MACDRV_AX_ROLE_BUTTON) return NSAccessibilityButtonRole;
+    if (node.role == MACDRV_AX_ROLE_EDIT) return NSAccessibilityTextFieldRole;
+    if (node.role == MACDRV_AX_ROLE_CHECKBOX) return NSAccessibilityCheckBoxRole;
+    if (node.role == MACDRV_AX_ROLE_RADIO) return NSAccessibilityRadioButtonRole;
