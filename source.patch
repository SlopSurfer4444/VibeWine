+                             MACDRV_AX_PRESSABLE | MACDRV_AX_SETTABLE | MACDRV_AX_CHECKED | MACDRV_AX_MIXED)) ||
+            ((node->flags & (MACDRV_AX_CHECKED | MACDRV_AX_MIXED)) &&
