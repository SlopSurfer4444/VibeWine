#include "cs2_trace.hpp"
#include "wave7_feedback.h"
#include "wave7_visibility.h"
#include <array>
#include <cassert>
#include <cmath>
#include <cstring>
#include <deque>
#include <iostream>
#include <unordered_map>
using obj_handle_t=uint64_t;
// EXACT_PROPERTY_ENUM
namespace {
std::array<unsigned,8> operations{};
unsigned gpu_calls=0,status_calls=0,texture_calls=0,visibility_calls=0;
bool supported=true,register_unsupported=false;
struct Session {W7FBRecord identity{};std::deque<W7FBRecord> queued;W7FBStats stats{};};
std::unordered_map<uint64_t,Session> sessions;
uint64_t next_session=100;
unsigned feedback_native_calls(){unsigned total=0;for(auto n:operations)total+=n;return total;}
void reset_counts(){operations={};gpu_calls=status_calls=texture_calls=visibility_calls=0;}
}
static uint64_t MTLCommandBuffer_property(obj_handle_t value,WMTCommandBufferProperty property) {
  if(property==WMTCommandBufferPropertyGPUStartTime || property==WMTCommandBufferPropertyGPUEndTime){gpu_calls++;return property==WMTCommandBufferPropertyGPUStartTime?100:200;}
  if(uint32_t(property)==W7VS_PROPERTY){
    visibility_calls++;auto &r=*reinterpret_cast<W7VSRequest*>(value);r.status=W7VS_OK;r.snapshot.layer_identity=42;r.snapshot.sequence=1;return W7VS_REPLY;
  }
  assert(uint32_t(property)==W7FB_PROPERTY);
  auto &r=*reinterpret_cast<W7FBRequest*>(value);
  assert(r.size==sizeof(r) && r.version==W7FB_VERSION && r.op<operations.size());operations[r.op]++;
  r.capabilities=supported?(W7FB_CAP_PRESENTED_HANDLER|W7FB_CAP_CLOSE_QUEUED_DISCARD):0;
  if(r.op==W7FB_QUERY){r.status=supported?W7FB_OK:W7FB_UNSUPPORTED;return W7FB_REPLY;}
  if(r.op==W7FB_OPEN){r.session=next_session++;sessions[r.session].identity=r.record;r.status=W7FB_OK;return W7FB_REPLY;}
  auto it=sessions.find(r.session);assert(it!=sessions.end());auto &session=it->second;
  r.status=W7FB_OK;
  if(r.op==W7FB_REGISTER){
    if(register_unsupported){r.status=W7FB_UNSUPPORTED;return W7FB_REPLY;}
    assert(r.record.generation==session.identity.generation && r.record.swapchain_serial==session.identity.swapchain_serial);
    auto record=r.record;record.clock_domain=W7FB_CLOCK_CA_HOST_SECONDS;record.presented_seconds=10.5;session.queued.push_back(record);
    session.stats.accepted++;session.stats.completed++;
  } else if(r.op==W7FB_POLL){
    if(session.queued.empty())r.status=W7FB_EMPTY;
    else{r.record=session.queued.front();session.queued.pop_front();}
  }
  r.stats=session.stats;r.stats.queued=session.queued.size();
  if(r.op==W7FB_CLOSE)sessions.erase(it);
  return W7FB_REPLY;
}
namespace WMT {
struct Texture {bool valid=true;explicit operator bool()const{return valid;}uint64_t width(){texture_calls++;return 1920;}uint64_t height(){texture_calls++;return 1080;}};
struct MetalDrawable {
  uint64_t handle=1;explicit operator bool()const{return handle!=0;}operator obj_handle_t()const{return handle;}
  Texture texture(){texture_calls++;return {};}
};
}
namespace dxmt {
class Presenter {public:
  uint64_t feedback_session_=0,feedback_capabilities_=0,swapchain_serial_=11;
  uint32_t feedback_generation_=0,visibility_generation_=0;
  uint64_t visibility_last_poll_ns_=0;
  bool feedback_capability_checked_=false;
  struct {uint64_t handle=12;}layer_;
  ~Presenter();
  void drainPresentationFeedback();void closePresentationFeedback();
  void observeVisibility(uint32_t,uint64_t);
  void observePresentation(WMT::MetalDrawable,uint64_t,uint64_t,uint32_t);
};
// EXACT_PRESENTER
}
namespace cs2trace=dxmt::cs2trace;
using namespace dxmt::cs2trace;
static Event *events(){return reinterpret_cast<Event*>(reinterpret_cast<char*>(buffer())+4096);}
static void arm(uint32_t gen){auto h=buffer();assert(h && !controlWriters(h->control));h->control=controlWord(gen,CaptureState::Open);}
static unsigned event_count(uint32_t type,uint64_t from=0){unsigned count=0;for(uint64_t i=from;i<buffer()->next;i++)count+=events()[i].type==type;return count;}
static constexpr unsigned WMTCommandBufferStatusCompleted=4,WMTCommandBufferStatusError=5;
struct CommandBuffer {
  obj_handle_t handle=1;unsigned result=WMTCommandBufferStatusCompleted;
  unsigned status(){status_calls++;return result;}
  // EXACT_GPU_GETTERS
};
struct Queue {
  struct {uint32_t trace_generation=7;uint64_t frame_=1;CommandBuffer attached_cmdbuf;}chunk;
  uint64_t traceSerial(){return 55;}
  void observe_completion(){const uint64_t internal_seq=1;
    // EXACT_QUEUE_OBSERVATION
  }
};
static void check_compiler_events(){
  if(profile()!=Profile::CompileWaits)return;
  auto from=buffer()->next;
  for(uint32_t type:{3u,4u,5u,17u,19u,80u,81u,82u,83u,84u,85u,86u,87u,88u,89u,93u,94u}){
    record(7,type,10,20,1);assert(event_count(type,from)==1);
  }
  assert(event_count(95)==1); // Profile metadata survives native observer gates.
}
int main(){
  arm(7);generation();const auto initial_profile=profile();const bool allowed=profileAllows(70);
  // Environment changes cannot turn an already-selected compiler process into
  // a presentation producer (or vice versa).
  setenv("DXMT_CS2_TRACE_PROFILE",allowed?"compile-waits":"presentation-waits",1);assert(profile()==initial_profile);
  reset_counts();
  {
    dxmt::Presenter p;p.observePresentation({},1,3,7);p.observePresentation({},2,3,7);
    if(!allowed){assert(feedback_native_calls()==0 && !texture_calls && !visibility_calls && sessions.empty());}
    else{
      assert(operations[W7FB_QUERY]==1 && operations[W7FB_OPEN]==1 && operations[W7FB_REGISTER]==2);
      assert(operations[W7FB_POLL]==3 && operations[W7FB_STATUS]==2 && texture_calls==6);
      assert(sessions.size()==1 && event_count(70)==1 && event_count(71)==1 && event_count(72)==1 && event_count(73)==1);
      assert(visibility_calls==(initial_profile==Profile::PresentationWaits?1u:0u));
    }
  }
  assert(sessions.empty());if(allowed)assert(operations[W7FB_CLOSE]==1 && event_count(75)==1 && event_count(78)==1);
  if(!allowed){
    // A deliberately injected preexisting owner tests policy-disallow cleanup
    // without pretending the real process-immutable profile can switch.
    reset_counts();dxmt::Presenter p;sessions[99].identity.generation=7;sessions[99].identity.swapchain_serial=11;p.feedback_session_=99;p.feedback_generation_=7;
    p.observePresentation({},3,3,7);
    assert(sessions.empty() && !p.feedback_session_ && operations[W7FB_CLOSE]==1);
    assert(!operations[W7FB_QUERY] && !operations[W7FB_OPEN] && !operations[W7FB_REGISTER] && !texture_calls);
    const auto after_cleanup=feedback_native_calls();p.observePresentation({},4,3,7);assert(feedback_native_calls()==after_cleanup);
  }
  if(allowed){
    reset_counts();supported=false;
    {dxmt::Presenter p;p.observePresentation({},1,3,7);p.observePresentation({},2,3,7);assert(operations[W7FB_QUERY]==1 && !operations[W7FB_OPEN] && !operations[W7FB_REGISTER] && !texture_calls && sessions.empty());}
    supported=true;reset_counts();register_unsupported=true;
    {dxmt::Presenter p;p.observePresentation({},1,3,7);assert(operations[W7FB_OPEN]==1 && operations[W7FB_REGISTER]==1 && operations[W7FB_CLOSE]==1 && !p.feedback_session_ && sessions.empty());}
    register_unsupported=false;
  }
  generation();reset_counts();Queue queue;queue.observe_completion();
  assert(status_calls==1); // Existing completion status observation is retained.
  if(profileAllows(24))assert(gpu_calls==2 && event_count(24)==1);else assert(gpu_calls==0 && !event_count(24));
  queue.chunk.attached_cmdbuf.result=WMTCommandBufferStatusError;queue.observe_completion();assert(status_calls==2 && gpu_calls==(profileAllows(24)?2u:0u));
  queue.chunk.trace_generation=6;queue.observe_completion();assert(status_calls==2);
  check_compiler_events();
  if(allowed){
    reset_counts();dxmt::Presenter p;p.observePresentation({},1,3,7);auto old=p.feedback_session_;assert(old);
    arm(8);p.observePresentation({},2,3,7);assert(!p.feedback_session_ && !sessions.contains(old) && operations[W7FB_CLOSE]==1 && operations[W7FB_OPEN]==1);
    p.observePresentation({},3,3,8);assert(p.feedback_session_ && operations[W7FB_OPEN]==2);
    buffer()->control=controlWord(8,CaptureState::Closed);p.observePresentation({},4,3,8);
    assert(!p.feedback_session_ && sessions.empty() && operations[W7FB_CLOSE]==2);
  }
  std::cout<<"PASS exact observer methods: native operation gates, retained cleanup, profile immutability, generation close, compiler coverage\n";
}
