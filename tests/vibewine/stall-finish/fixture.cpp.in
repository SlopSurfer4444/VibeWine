#include <array>
#include <atomic>
#include <cstdint>
#include <cstdio>
#include <iostream>
#include <stdexcept>
#include <string>
#include <vector>

static std::vector<std::string> events;
static void event(const std::string &value) { events.push_back(value); }
static void require(bool value, const char *message) {
  if (!value) throw std::runtime_error(message);
}
namespace env { void setThreadName(const char *) {} }
constexpr int THREAD_PRIORITY_TIME_CRITICAL = 1;
int GetCurrentThread() { return 1; }
void SetThreadPriority(int, int) {}
unsigned GetCurrentProcessId() { return 123; }
#define TRACE(...) do {} while (0)
template<class... Args> void log_error(Args &&...) { event("error"); }
#define ERR(...) log_error(__VA_ARGS__)
constexpr unsigned WMTCommandBufferStatusScheduled = 3;
constexpr unsigned WMTCommandBufferStatusCompleted = 4;
constexpr unsigned WMTCommandBufferStatusError = 5;

namespace cs2trace {
static unsigned current_generation = 7;
static unsigned expected_detail_generation = 7;
static bool detail = true, gpu_profile = true;
unsigned generation() { return current_generation; }
unsigned detailLimit() { return detail; }
bool profileAllows(unsigned type) { return type == 24 && gpu_profile; }
uint64_t now() { return 100; }
struct Scope {
  unsigned type;
  uint64_t object;
  ~Scope() { event("wait-scope-end"); }
};
// Spy only: real admission, bounded recording and timestamps are tested by the
// trace producer suite. This fixture verifies production call placement/data.
struct StallScope {
  unsigned type;
  StallScope(unsigned value, uint64_t queue, uint64_t sequence, uint64_t frame) : type(value) {
    require(queue == 42 && sequence == 1 && frame == 77, "stall scope identity");
    event("begin-" + std::to_string(type));
  }
  ~StallScope() { event("end-" + std::to_string(type)); }
};
void record(unsigned, unsigned type, uint64_t, uint64_t, uint64_t queue,
            unsigned, uint64_t sequence, uint64_t frame) {
  require(queue == 42 && sequence == 1 && frame == 77, "record identity");
  event("record-" + std::to_string(type));
}
void detailRecord(unsigned gen, unsigned type, uint64_t, uint64_t, uint64_t queue,
                  unsigned, uint64_t sequence, uint64_t frame) {
  require(gen == expected_detail_generation && queue == 42 && sequence == 1 && frame == 77, "saved detail identity");
  event("detail-" + std::to_string(type));
}
}

struct Text { Text description() const { return {}; } const char *getUTF8String() const { return "mock"; } };
struct Logs {
  bool present = false;
  explicit operator bool() const { return present; }
  std::array<Text, 1> elements() const { return {}; }
};
struct CommandBuffer {
  unsigned state = WMTCommandBufferStatusCompleted;
  bool with_logs = false;
  uint64_t gpu_start = 10, gpu_end = 20;
  unsigned status() { event("status"); return state; }
  void waitUntilCompleted() { event("wait"); state = WMTCommandBufferStatusCompleted; }
  Text error() { return {}; }
  Logs logs() { event("logs"); return {with_logs}; }
  uint64_t gpuStartTime() { event("gpu-start"); return gpu_start; }
  uint64_t gpuEndTime() { event("gpu-end"); return gpu_end; }
};
struct Readback {
  Readback &operator=(const Readback &) { event("readback-release"); return *this; }
};
struct Chunk {
  CommandBuffer attached_cmdbuf;
  unsigned trace_generation = 7;
  uint64_t frame_ = 77, signal_frame_latency_fence_ = 55;
  Readback readback;
  void reset() {
    event("reset");
    // Poison identities to detect fetching either one after resource release.
    trace_generation = 0; frame_ = 0; signal_frame_latency_fence_ = ~0ull;
  }
};
struct Stopped { bool value = false; bool load() const { return value; } };
struct Ready {
  Stopped *stopped;
  unsigned calls = 0;
  void wait(uint64_t sequence, std::memory_order) {
    require(sequence == ++calls, "ready wait sequence");
    event("ready-" + std::to_string(sequence));
    if (sequence == 2) stopped->value = true;
  }
};
struct Fence {
  std::string name;
  uint64_t expected;
  void signal(uint64_t value) { require(value == expected, "fence sequence"); event(name); }
};
struct Counter {
  unsigned value = 1;
  void fetch_sub(unsigned delta, std::memory_order order) {
    require(delta == 1 && value == 1 && order == std::memory_order_release, "counter decrement");
    --value; event("counter-decrement");
  }
  void notify_one() { require(value == 0, "counter notify before decrement"); event("counter-notify"); }
};
struct Allocator {
  std::string name;
  void free_blocks(uint64_t sequence) { require(sequence == 1, "allocator sequence"); event(name); }
};
struct Idle {
  int sweep(uint64_t sequence) { require(sequence == 1, "sweep sequence"); event("sweep"); return 99; }
};
struct Diagnostics {
  bool active = true;
  bool enabled() { event("diagnostics-enabled"); return active; }
  bool record(uint64_t, int sample, unsigned pid, uint64_t queue, char (&)[1024]) {
    require(sample == 99 && pid == 123 && queue == 42, "diagnostic identity");
    event("diagnostics-record");
    return false; // No stderr writes; still proves scope excludes this endpoint.
  }
};
class CommandQueue {
public:
  static constexpr unsigned kCommandChunkCount = 32;
  Stopped stopped;
  Ready ready_for_commit{&stopped};
  std::array<Chunk, kCommandChunkCount> chunks;
  Fence frame_latency_fence_{"latency-fence", 55}, cpu_coherent{"cpu-fence", 1};
  Counter chunk_ongoing;
  Idle idle;
  Idle *idle_retirement_ = &idle;
  Diagnostics idle_diagnostics_;
  Allocator staging_allocator{"staging-free"}, copy_temp_allocator{"copy-free"}, argbuf_allocator{"argbuf-free"};
  uint64_t traceSerial() const { return 42; }
  uint32_t WaitForFinishThread();
};

// EXACT_WAIT_FOR_FINISH_THREAD

static void run_case(unsigned status, bool matching_generation, bool details,
                     bool gpu, bool logs, bool latency, bool diagnostics,
                     bool invalid_gpu = false, bool stale_generation = false) {
  events.clear();
  cs2trace::detail = details; cs2trace::gpu_profile = gpu;
  CommandQueue queue;
  auto &chunk = queue.chunks[1];
  chunk.attached_cmdbuf.state = status;
  chunk.attached_cmdbuf.with_logs = logs;
  if (invalid_gpu) chunk.attached_cmdbuf.gpu_end = 0;
  chunk.trace_generation = matching_generation ? 7 : stale_generation ? 8 : 0;
  cs2trace::expected_detail_generation = chunk.trace_generation;
  const bool has_generation = chunk.trace_generation != 0;
  chunk.signal_frame_latency_fence_ = latency ? 55 : ~0ull;
  queue.idle_diagnostics_.active = diagnostics;
  require(queue.WaitForFinishThread() == 0, "finish return");
  std::vector<std::string> expected{"ready-1", "status"};
  if (status <= WMTCommandBufferStatusScheduled) {
    expected.insert(expected.end(), {"wait", "wait-scope-end"});
    status = WMTCommandBufferStatusCompleted;
  }
  if (matching_generation) {
    expected.insert(expected.end(), {"status", "record-23"});
    if (status == WMTCommandBufferStatusCompleted && gpu) {
      expected.insert(expected.end(), {"gpu-start", "gpu-end"});
      if (!invalid_gpu) expected.push_back("record-24");
    }
  }
  expected.push_back("status");
  if (status == WMTCommandBufferStatusError) expected.push_back("error");
  expected.push_back("logs");
  if (logs) expected.push_back("error");
  if (latency) expected.push_back("latency-fence");
  expected.push_back("readback-release");
  if (details && has_generation) expected.push_back("detail-90");
  expected.insert(expected.end(), {"begin-110", "reset", "end-110"});
  if (details && has_generation) expected.push_back("detail-91");
  expected.push_back("cpu-fence");
#if DXMT_IDLE_RETIREMENT
  expected.insert(expected.end(), {"begin-108", "sweep", "end-108", "diagnostics-enabled"});
  if (diagnostics) expected.push_back("diagnostics-record");
#endif
  if (details && has_generation) expected.push_back("detail-92");
  expected.insert(expected.end(), {"counter-decrement", "counter-notify", "begin-109",
                                  "staging-free", "copy-free", "argbuf-free", "end-109", "ready-2"});
  if (events != expected) {
    std::cerr << "actual:"; for (const auto &item : events) std::cerr << " " << item;
    std::cerr << "\nexpected:"; for (const auto &item : expected) std::cerr << " " << item;
    std::cerr << "\n";
    throw std::runtime_error("finish operation order/count/scope");
  }
  require(queue.chunk_ongoing.value == 0 && chunk.frame_ == 0, "final state");
}

int main() {
  try {
    run_case(WMTCommandBufferStatusScheduled, true, true, true, false, true, true);
    run_case(WMTCommandBufferStatusCompleted, true, true, false, false, false, false);
    run_case(WMTCommandBufferStatusError, true, true, true, true, true, true);
    run_case(WMTCommandBufferStatusCompleted, false, true, true, false, true, true);
    run_case(WMTCommandBufferStatusCompleted, true, false, true, false, true, true);
    run_case(WMTCommandBufferStatusCompleted, true, true, true, false, true, true, true);
    run_case(WMTCommandBufferStatusCompleted, false, true, true, false, true, true, false, true);
    events.clear();
    CommandQueue stopped; stopped.stopped.value = true;
    require(stopped.WaitForFinishThread() == 0 && events.empty(), "initial stop");
    std::cout << "PASS complete finish method idle=" << DXMT_IDLE_RETIREMENT
              << " operation order, saved identities, status/error/GPU/detail/stop branches\n";
    return 0;
  } catch (const std::exception &error) {
    std::cerr << "FAIL " << error.what() << "\n";
    return 1;
  }
}
