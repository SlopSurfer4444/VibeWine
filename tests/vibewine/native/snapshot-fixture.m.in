 uint64_t old_version=query.version; struct unixcall_update_display_setting clear={1,0,{NULL}}; _WMTUpdateDisplaySetting(&clear); set_metadata(1,1); _WMTQueryDisplaySettingForLayer(&query); assert(query.version>old_version);
 pthread_t threads[4]; assert(!pthread_create(&threads[0],NULL,writer,NULL)); assert(!pthread_create(&threads[1],NULL,writer,NULL)); assert(!pthread_create(&threads[2],NULL,reader,NULL)); assert(!pthread_create(&threads[3],NULL,reader,NULL)); for(unsigned i=0;i<4;i++) pthread_join(threads[i],NULL); assert(atomic_load(&async_count)==requests);
