static NSMutableArray* async_blocks;
static _Atomic unsigned async_count, layer_destroyed, appkit_reads;
static void fake_async(dispatch_queue_t q,dispatch_block_t block) { id copy=[block copy]; pthread_mutex_lock(&async_lock); [async_blocks addObject:copy]; atomic_fetch_add(&async_count,1); pthread_mutex_unlock(&async_lock); [copy release]; }

@interface FakeThread : NSObject
+ (BOOL)isMainThread;
@end
@implementation FakeThread
+ (BOOL)isMainThread { return simulated_main; }
@end
static void fake_sync(dispatch_queue_t queue,dispatch_block_t block) { assert(!simulated_main); pthread_mutex_lock(&main_lock); ++dispatches; simulated_main=YES; block(); simulated_main=NO; pthread_mutex_unlock(&main_lock); }
#define NSThread FakeThread
#define dispatch_sync fake_sync
#define dispatch_async fake_async
#define CHECK_MAIN() do { assert(simulated_main); assert(!snapshot_lock_depth); atomic_fetch_add(&appkit_reads,1); } while(0)
static void execute_on_main(dispatch_block_t block) { if([FakeThread isMainThread]) block(); else fake_sync(NULL,block); }
static void drain_async(void) { for(;;) { pthread_mutex_lock(&async_lock); if(!async_blocks.count) { pthread_mutex_unlock(&async_lock); break; } dispatch_block_t block=[async_blocks[0] copy]; [async_blocks removeObjectAtIndex:0]; pthread_mutex_unlock(&async_lock); execute_on_main(block); [block release]; } }
