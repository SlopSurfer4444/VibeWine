 execute_on_main(^{ view->fakeWindow=new_window; new_window->fakeScreen=nil; w7ds_refresh_layer_main(layer); }); _WMTQueryDisplaySettingForLayer(&query); assert(!query.version && query.edr_value.maximum_potential_edr_color_component_value==1);
