#define ACCESS(type,name,setter) - (type)name { CHECK_MAIN(); return _##name; } - (void)setter:(type)v { CHECK_MAIN(); _##name=v; }
@implementation CAMetalLayer
- (void)dealloc { atomic_fetch_add(&layer_destroyed,1); [super dealloc]; }
