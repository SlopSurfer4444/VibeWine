static void set_metadata(unsigned id,unsigned value) {
 struct WMTHDRMetadata m; memset(&m,(int)value,sizeof(m));
 struct unixcall_update_display_setting u={id,(enum WMTColorSpace)value,{&m}};
 assert(_WMTUpdateDisplaySetting(&u)==0);
}
static void verify_metadata(struct WMTHDRMetadata* m,unsigned value) { unsigned char* bytes=(void*)m; for(unsigned i=0;i<sizeof(*m);i++) assert(bytes[i]==value); }
static void *writer(void* unused) { @autoreleasepool { for(unsigned i=0;i<10000;i++) set_metadata(1,(i%200)+1); } return NULL; }
static void *reader(void* unused) { @autoreleasepool { for(unsigned i=0;i<10000;i++) {
 struct WMTHDRMetadata m={0}; struct unixcall_query_display_setting q={1,0,{&m},false};
 assert(!_WMTQueryDisplaySetting(&q)); assert(q.ret); verify_metadata(&m,q.colorspace);
 struct unixcall_query_display_setting_for_layer l={(obj_handle_t)layer,0,0,{&m},{0,0}};
 assert(!_WMTQueryDisplaySettingForLayer(&l)); assert(l.version); verify_metadata(&m,l.colorspace); assert(l.edr_value.maximum_edr_color_component_value==2.0);
 } } return NULL; }
static pthread_mutex_t device_lock=PTHREAD_MUTEX_INITIALIZER;
static dispatch_semaphore_t main_blocked;
static void *blocked_main(void* unused) { pthread_mutex_lock(&main_lock); simulated_main=YES; dispatch_semaphore_signal(main_blocked); pthread_mutex_lock(&device_lock); pthread_mutex_unlock(&device_lock); simulated_main=NO; pthread_mutex_unlock(&main_lock); return NULL; }
static void *cold_reader(void* object) { @autoreleasepool { struct WMTLayerProps p; struct unixcall_generic_obj_ptr_noret q={(obj_handle_t)object,{&p}}; for(unsigned i=0;i<100;i++) { _MetalLayer_getProps(&q); assert(p.contents_scale==1.0); } } return NULL; }

struct PropertyContext { NSWindow* window; NSScreen* first; NSScreen* second; };
static void *property_writer(void* pointer) { struct PropertyContext* c=pointer; @autoreleasepool {
 for(unsigned i=1;i<=2000;i++) execute_on_main(^{ layer.contentsScale=i*3; layer.drawableSize=NSMakeSize(i,i*2); c->window->fakeScreen=i%2?c->first:c->second; w7ds_refresh_layer_main(layer); });
 } return NULL; }
static void *property_reader(void* unused) { @autoreleasepool {
 for(unsigned i=0;i<10000;i++) {
  struct WMTLayerProps p; struct unixcall_generic_obj_ptr_noret get={(obj_handle_t)layer,{&p}}; _MetalLayer_getProps(&get); assert(p.contents_scale==p.drawable_width*3 && p.drawable_height==p.drawable_width*2);
  struct WMTHDRMetadata m; struct unixcall_query_display_setting_for_layer q={(obj_handle_t)layer,0,0,{&m},{0,0}}; _WMTQueryDisplaySettingForLayer(&q); assert(q.version); assert(q.colorspace==11 || q.colorspace==22); verify_metadata(&m,q.colorspace); assert(q.edr_value.maximum_edr_color_component_value==(q.colorspace==11?2:3));
 }
 } return NULL; }

