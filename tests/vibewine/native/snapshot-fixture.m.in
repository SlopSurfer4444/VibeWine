@interface NSScreen : NSObject { @public unsigned fakeID; double current,reference,potential; }
+ (NSArray*)screens;
- (NSDictionary*)deviceDescription;
- (double)maximumExtendedDynamicRangeColorComponentValue;
- (double)maximumPotentialExtendedDynamicRangeColorComponentValue;
- (double)maximumReferenceExtendedDynamicRangeColorComponentValue;
@end
@implementation NSScreen
+ (NSArray*)screens { CHECK_MAIN(); return fake_screens; }
- (NSDictionary*)deviceDescription { CHECK_MAIN(); return @{@"NSScreenNumber":@(fakeID)}; }
- (double)maximumExtendedDynamicRangeColorComponentValue { CHECK_MAIN(); return current; }
- (double)maximumPotentialExtendedDynamicRangeColorComponentValue { CHECK_MAIN(); return potential; }
- (double)maximumReferenceExtendedDynamicRangeColorComponentValue { CHECK_MAIN(); return reference; }
@end
@interface NSWindow : NSObject { @public NSScreen* fakeScreen; BOOL fakeVisible,fakeMini; NSUInteger fakeOcclusion; }
@property(readonly) NSScreen* screen;
