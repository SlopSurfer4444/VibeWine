@end
@implementation NSWindow
- (BOOL)isVisible { CHECK_MAIN(); return fakeVisible; }
- (BOOL)isMiniaturized { CHECK_MAIN(); return fakeMini; }
- (NSUInteger)occlusionState { CHECK_MAIN(); return fakeOcclusion; }
- (NSScreen*)screen { CHECK_MAIN(); return fakeScreen; }
@end
@interface NSView : NSObject { @public NSWindow* fakeWindow; BOOL fakeHidden; }
@property(readonly) NSWindow* window;
- (BOOL)isHiddenOrHasHiddenAncestor;
@end
@implementation NSView
- (NSWindow*)window { CHECK_MAIN(); return fakeWindow; }
- (BOOL)isHiddenOrHasHiddenAncestor { CHECK_MAIN(); return fakeHidden; }
@end
