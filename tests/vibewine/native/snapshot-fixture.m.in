static _Atomic BOOL native_symbol=YES,native_available=YES;
static int fake_copy_edr(uint32_t id,double values[3]) { if(!atomic_load(&native_available) || id<1 || id>2) return 0; values[0]=id==1?2.0:3.0; values[1]=id==1?1.0:2.0; values[2]=id==1?4.0:8.0; return 1; }
static void *fake_dlsym(void *scope,const char *name) { return atomic_load(&native_symbol) && !strcmp(name,"macdrv_copy_display_edr_v1") ? fake_copy_edr : NULL; }
