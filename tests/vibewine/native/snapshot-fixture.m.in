static _Thread_local BOOL simulated_main;
static pthread_mutex_t main_lock=PTHREAD_MUTEX_INITIALIZER;
static unsigned dispatches;
static pthread_mutex_t async_lock=PTHREAD_MUTEX_INITIALIZER;
static pthread_mutex_t w7ds_lock;
static _Thread_local unsigned snapshot_lock_depth;
static int tracked_lock(pthread_mutex_t* mutex) { int ret=pthread_mutex_lock(mutex); if(!ret && mutex==&w7ds_lock) ++snapshot_lock_depth; return ret; }
static int tracked_unlock(pthread_mutex_t* mutex) { if(mutex==&w7ds_lock) { assert(snapshot_lock_depth==1); --snapshot_lock_depth; } return pthread_mutex_unlock(mutex); }
#define pthread_mutex_lock tracked_lock
#define pthread_mutex_unlock tracked_unlock
#define CAMetalLayer W7TestMetalLayer
