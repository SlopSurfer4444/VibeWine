ACCESS(BOOL,wantsExtendedDynamicRangeContent,setWantsExtendedDynamicRangeContent)
ACCESS(double,contentsScale,setContentsScale)
ACCESS(NSSize,drawableSize,setDrawableSize)
ACCESS(enum WMTPixelFormat,pixelFormat,setPixelFormat)
@synthesize contentsGravity,backgroundColor;
@end

