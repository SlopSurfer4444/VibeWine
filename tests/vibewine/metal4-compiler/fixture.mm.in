/* Owned, bounded native fixture. Exact factories are injected by the runner.
 * Compile as Objective-C C2x, MRC: the production .c functions use C pointers. */
#import <Foundation/Foundation.h>
#import <Metal/Metal.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include "winemetal_thunks.h"
typedef int NTSTATUS;
#define STATUS_SUCCESS 0
static MTLPixelFormat to_metal_pixel_format(enum WMTPixelFormat f) {
  return (MTLPixelFormat)ORIGINAL_FORMAT(f);
}
#include <time.h>
#include <pthread.h>
struct CostRecord { uint64_t setup_ns,pipeline_ns,wait_ns,total_ns; unsigned setup_calls,pipeline_calls; };
static _Thread_local struct CostRecord cost_current;
static _Thread_local bool cost_unlocked;
static uint64_t cost_now(void) { struct timespec t; clock_gettime(CLOCK_MONOTONIC_RAW,&t); return (uint64_t)t.tv_sec*1000000000+t.tv_nsec; }
static int cost_mutex_lock(pthread_mutex_t *lock) {
  if(cost_unlocked) return 0;
  uint64_t start=cost_now(); int result=pthread_mutex_lock(lock); cost_current.wait_ns+=cost_now()-start; return result;
}
static int cost_mutex_unlock(pthread_mutex_t *lock) { return cost_unlocked ? 0:pthread_mutex_unlock(lock); }
/* The unchanged helper's lock is observed, never bypassed in parity runs. */
#define pthread_mutex_lock cost_mutex_lock
#define pthread_mutex_unlock cost_mutex_unlock
#include "next_metal4_compiler.inc"
#undef pthread_mutex_lock
#undef pthread_mutex_unlock
// EXACT_NATIVE_FUNCTIONS

#if !WMT_METAL4_AVAILABLE
#error This fixture requires Metal4 SDK headers; the runner tests the unavailable guard separately.
#endif
static void require(bool value, const char *what) {
  if (!value) { fprintf(stderr, "FAIL %s\n", what); exit(1); }
}
static void no_error(NSError *error, const char *what) {
  if (error) { fprintf(stderr, "FAIL %s: %s\n", what, error.localizedDescription.UTF8String); exit(1); }
}
static NSString * const source = @"#include <metal_stdlib>\n"
  "using namespace metal;\n"
  "constant float gain [[function_constant(0)]];\n"
  "constant uint multiplier [[function_constant(1)]];\n"
  "vertex float4 vertex_main(uint i [[vertex_id]], device const float2 *p [[buffer(0)]], "
    "constant float &z [[buffer(1)]]) { return float4(p[i],z,1); }\n"
  "vertex float4 vertex_raw(uint i [[vertex_id]]) { return float4(float(i),0,0,1); }\n"
  "fragment float4 fragment_main(texture2d<float,access::read> t [[texture(0)]], "
    "constant float4 &offset [[buffer(0)]]) { return t.read(uint2(0))*gain+offset; }\n"
  "kernel void compute_main(device const uint *in [[buffer(0)]], device uint *out [[buffer(1)]], "
    "constant uint &bias [[buffer(2)]], texture2d<uint,access::read> t [[texture(0)]], "
    "uint i [[thread_position_in_grid]]) { out[i]=in[i]*multiplier+bias+t.read(uint2(i%4,0)).x; }\n";

static id<MTLFunction> ordinary(id<MTLLibrary> lib, const char *name) {
  struct unixcall_generic_obj_uint64_obj_ret p = {0};
  p.handle=(obj_handle_t)lib; p.arg=(uint64_t)name;
  require(_MTLLibrary_newFunction(&p)==STATUS_SUCCESS && p.ret, "ordinary exact function factory");
  return (id<MTLFunction>)p.ret;
}
static id<MTLFunction> specialized(id<MTLLibrary> lib, const char *name,
                                    const void *value, enum WMTDataType type, uint16_t index) {
  struct WMTFunctionConstant c = {0}; c.data.ptr=value; c.type=type; c.index=index;
  struct unixcall_mtllibrary_newfunction_with_constants p = {0};
  p.library=(obj_handle_t)lib; p.name.ptr=name; p.constants.ptr=&c; p.num_constants=1;
  require(_MTLLibrary_newFunctionWithConstants(&p)==STATUS_SUCCESS, "specialized exact factory status");
  no_error((NSError *)p.ret_error, "specialized exact function factory");
  require(p.ret!=0, "specialized exact function result");
  return (id<MTLFunction>)p.ret;
}
static struct WMTRenderPipelineInfo render_info(id<MTLFunction> v, id<MTLFunction> f,
                                               unsigned samples, bool blend, bool masked) {
  struct WMTRenderPipelineInfo i = {0};
  i.vertex_function=(obj_handle_t)v; i.fragment_function=(obj_handle_t)f;
  i.rasterization_enabled=true; i.raster_sample_count=samples; i.max_tessellation_factor=1;
  i.input_primitive_topology=WMTPrimitiveTopologyClassTriangle;
  i.immutable_vertex_buffers=3; i.immutable_fragment_buffers=1;
  i.colors[0].pixel_format=WMTPixelFormatRGBA8Unorm;
  i.colors[0].blending_enabled=blend;
  i.colors[0].write_mask=masked ? WMTColorWriteMaskGreen|WMTColorWriteMaskAlpha : WMTColorWriteMaskAll;
  i.colors[0].src_rgb_blend_factor=WMTBlendFactorOne;
  i.colors[0].src_alpha_blend_factor=WMTBlendFactorOne;
  i.colors[0].dst_rgb_blend_factor=blend ? WMTBlendFactorOne : WMTBlendFactorZero;
  i.colors[0].dst_alpha_blend_factor=blend ? WMTBlendFactorOne : WMTBlendFactorZero;
  return i;
}
static MTLRenderPipelineDescriptor *render_desc(struct WMTRenderPipelineInfo i) {
  MTLRenderPipelineDescriptor *d=[[MTLRenderPipelineDescriptor alloc] init];
  d.vertexFunction=(id<MTLFunction>)i.vertex_function; d.fragmentFunction=(id<MTLFunction>)i.fragment_function;
  d.rasterSampleCount=i.raster_sample_count; d.rasterizationEnabled=i.rasterization_enabled;
  d.inputPrimitiveTopology=(MTLPrimitiveTopologyClass)i.input_primitive_topology;
  d.depthAttachmentPixelFormat=to_metal_pixel_format(i.depth_pixel_format);
  d.stencilAttachmentPixelFormat=to_metal_pixel_format(i.stencil_pixel_format);
  d.colorAttachments[0].pixelFormat=to_metal_pixel_format(i.colors[0].pixel_format);
  d.colorAttachments[0].writeMask=(MTLColorWriteMask)i.colors[0].write_mask;
  d.colorAttachments[0].blendingEnabled=i.colors[0].blending_enabled;
  d.colorAttachments[0].sourceRGBBlendFactor=(MTLBlendFactor)i.colors[0].src_rgb_blend_factor;
  d.colorAttachments[0].sourceAlphaBlendFactor=(MTLBlendFactor)i.colors[0].src_alpha_blend_factor;
  d.colorAttachments[0].destinationRGBBlendFactor=(MTLBlendFactor)i.colors[0].dst_rgb_blend_factor;
  d.colorAttachments[0].destinationAlphaBlendFactor=(MTLBlendFactor)i.colors[0].dst_alpha_blend_factor;
  return d;
}
static id<MTLRenderPipelineState> native_render(id<MTLDevice> dev, struct WMTRenderPipelineInfo *i) {
  struct unixcall_mtldevice_newrenderpso p = {0}; p.device=(obj_handle_t)dev; p.info.ptr=i;
  require(_MTLDevice_newRenderPipelineState(&p)==STATUS_SUCCESS, "exact render factory status");
  no_error((NSError *)p.ret_error, "exact render factory"); require(p.ret_pso, "exact render PSO");
  return (id<MTLRenderPipelineState>)p.ret_pso;
}
static void completed(id<MTLCommandBuffer> b) {
  [b commit]; [b waitUntilCompleted]; no_error(b.error, "GPU command buffer");
  require(b.status==MTLCommandBufferStatusCompleted, "GPU completed status");
}
enum { SIDE=8, PIXEL_BYTES=SIDE*SIDE*4 };
static void draw(id<MTLDevice> dev, id<MTLCommandQueue> q, id<MTLRenderPipelineState> pso,
                 unsigned samples, bool depth, unsigned char *out) {
  MTLTextureDescriptor *td=[MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatRGBA8Unorm
      width:SIDE height:SIDE mipmapped:NO]; td.usage=MTLTextureUsageRenderTarget;
  td.storageMode=MTLStorageModeShared; id<MTLTexture> target=[dev newTextureWithDescriptor:td];
  require(target!=nil, "render target allocation"); id<MTLTexture> multisample=nil;
  if (samples>1) { td.textureType=MTLTextureType2DMultisample; td.sampleCount=samples;
    td.storageMode=MTLStorageModePrivate; multisample=[dev newTextureWithDescriptor:td];
    require(multisample!=nil, "MSAA target allocation"); }
  td=[MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatRGBA8Unorm width:1 height:1 mipmapped:NO];
  td.usage=MTLTextureUsageShaderRead; td.storageMode=MTLStorageModeShared;
  id<MTLTexture> input=[dev newTextureWithDescriptor:td]; require(input!=nil, "sample texture allocation");
  const unsigned char texel[]={64,128,192,128};
  [input replaceRegion:MTLRegionMake2D(0,0,1,1) mipmapLevel:0 withBytes:texel bytesPerRow:4];
  const float positions[]={-1,-1, 3,-1, -1,3};
  id<MTLBuffer> vertices=[dev newBufferWithBytes:positions length:sizeof(positions) options:MTLResourceStorageModeShared];
  require(vertices!=nil, "vertex buffer allocation");
  MTLRenderPassDescriptor *pass=[MTLRenderPassDescriptor renderPassDescriptor];
  pass.colorAttachments[0].texture=multisample ?: target;
  pass.colorAttachments[0].loadAction=MTLLoadActionClear;
  pass.colorAttachments[0].clearColor=MTLClearColorMake(16.0/255,32.0/255,48.0/255,64.0/255);
  pass.colorAttachments[0].storeAction=samples>1 ? MTLStoreActionMultisampleResolve : MTLStoreActionStore;
  if (multisample) pass.colorAttachments[0].resolveTexture=target;
  id<MTLTexture> depth_target=nil; id<MTLDepthStencilState> depth_state=nil;
  if (depth) {
    td=[MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatDepth32Float width:SIDE height:SIDE mipmapped:NO];
    td.usage=MTLTextureUsageRenderTarget; td.storageMode=MTLStorageModePrivate;
    depth_target=[dev newTextureWithDescriptor:td]; require(depth_target!=nil, "depth target allocation");
    pass.depthAttachment.texture=depth_target; pass.depthAttachment.loadAction=MTLLoadActionClear;
    pass.depthAttachment.storeAction=MTLStoreActionDontCare; pass.depthAttachment.clearDepth=1;
    MTLDepthStencilDescriptor *dd=[[MTLDepthStencilDescriptor alloc] init];
    dd.depthCompareFunction=MTLCompareFunctionLess; dd.depthWriteEnabled=YES;
    depth_state=[dev newDepthStencilStateWithDescriptor:dd]; [dd release];
    require(depth_state!=nil, "depth state allocation");
  }
  id<MTLCommandBuffer> cb=[q commandBuffer]; id<MTLRenderCommandEncoder> e=[cb renderCommandEncoderWithDescriptor:pass];
  require(e!=nil, "render encoder"); [e setRenderPipelineState:pso]; [e setVertexBuffer:vertices offset:0 atIndex:0];
  [e setFragmentTexture:input atIndex:0]; if(depth) [e setDepthStencilState:depth_state];
  for(unsigned n=0;n<(depth ? 3u : 1u);++n) {
    float z=depth && n!=1 ? 0.75f : 0.25f;
    float offset[4]={0,0,0,0}; if(depth && n!=1) offset[n==0 ? 0 : 1]=0.125f;
    [e setVertexBytes:&z length:sizeof(z) atIndex:1];
    [e setFragmentBytes:offset length:sizeof(offset) atIndex:0];
    [e drawPrimitives:MTLPrimitiveTypeTriangle vertexStart:0 vertexCount:3];
  }
  [e endEncoding]; completed(cb);
  [target getBytes:out bytesPerRow:SIDE*4 fromRegion:MTLRegionMake2D(0,0,SIDE,SIDE) mipmapLevel:0];
  [depth_state release]; [depth_target release]; [vertices release]; [input release];
  [multisample release]; [target release];
}
static void golden(const unsigned char *bytes, const unsigned char rgba[4], const char *what) {
  for(unsigned i=0;i<PIXEL_BYTES;i++) if(bytes[i]!=rgba[i%4]) {
    fprintf(stderr,"FAIL %s byte %u got %u expected %u\n",what,i,bytes[i],rgba[i%4]); exit(1);
  }
}
static void render_case(id<MTLDevice> dev,id<MTLCommandQueue> q,id<MTLFunction> v,id<MTLFunction> f,
                        unsigned samples,bool blend,bool mask,bool depth_probe) {
  struct WMTRenderPipelineInfo i=render_info(v,f,samples,blend,mask);
  if(depth_probe) i.depth_pixel_format=WMTPixelFormatDepth32Float;
  MTLRenderPipelineDescriptor *d=render_desc(i);
  NSError *error=nil; id<MTLRenderPipelineState> checked=nil;
  require(wmt_metal4_render(dev,d,&i,&checked,&error),"Metal4 render route selected");
  no_error(error,"Metal4 render compile"); require(checked!=nil,"Metal4 render compile result");
  id<MTLRenderPipelineState> m4=native_render(dev,&i); [checked release];
  id<MTLRenderPipelineState> legacy=[dev newRenderPipelineStateWithDescriptor:d error:&error];
  no_error(error,"legacy render compile"); require(legacy!=nil,"legacy render compile result");
  [d release];
  unsigned char a[PIXEL_BYTES],b[PIXEL_BYTES],again[PIXEL_BYTES];
  const unsigned char base[]={32,64,96,64},added[]={48,96,144,128},masked[]={16,96,48,128};
  draw(dev,q,m4,samples,depth_probe,a); draw(dev,q,legacy,samples,depth_probe,b);
  draw(dev,q,m4,samples,depth_probe,again);
  golden(a,mask ? masked : blend ? added : base,"Metal4 render golden");
  golden(b,mask ? masked : blend ? added : base,"legacy render golden");
  require(!memcmp(a,b,sizeof(a)),"render Metal4/legacy byte parity");
  require(!memcmp(a,again,sizeof(a)),"render first/reuse byte parity");
  printf("PASS render samples=%u blend=%u mask=%u depth_probe=%u golden+legacy+reuse\n",samples,blend,mask,depth_probe);
  [legacy release]; [m4 release];
}
static void dispatch_compute(id<MTLDevice> dev,id<MTLCommandQueue> q,id<MTLComputePipelineState> pso,uint32_t *out) {
  uint32_t in[32]; for(unsigned i=0;i<32;i++) in[i]=i+1;
  id<MTLBuffer> input=[dev newBufferWithBytes:in length:sizeof(in) options:MTLResourceStorageModeShared];
  id<MTLBuffer> output=[dev newBufferWithLength:sizeof(in) options:MTLResourceStorageModeShared];
  require(input && output,"compute buffer allocation"); memset(output.contents,0xCD,sizeof(in));
  MTLTextureDescriptor *td=[MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatR32Uint width:4 height:1 mipmapped:NO];
  td.usage=MTLTextureUsageShaderRead; td.storageMode=MTLStorageModeShared;
  id<MTLTexture> tex=[dev newTextureWithDescriptor:td]; require(tex!=nil,"compute texture allocation");
  const uint32_t seed[]={2,3,5,7}; [tex replaceRegion:MTLRegionMake2D(0,0,4,1) mipmapLevel:0 withBytes:seed bytesPerRow:16];
  id<MTLCommandBuffer> cb=[q commandBuffer]; id<MTLComputeCommandEncoder> e=[cb computeCommandEncoder];
  require(e!=nil,"compute encoder"); [e setComputePipelineState:pso];
  [e setBuffer:input offset:0 atIndex:0]; [e setBuffer:output offset:0 atIndex:1];
  const uint32_t bias=11; [e setBytes:&bias length:sizeof(bias) atIndex:2]; [e setTexture:tex atIndex:0];
  [e dispatchThreads:MTLSizeMake(32,1,1) threadsPerThreadgroup:MTLSizeMake(1,1,1)];
  [e endEncoding]; completed(cb); memcpy(out,output.contents,sizeof(in));
  for(unsigned i=0;i<32;i++) require(out[i]==(i+1)*3+11+seed[i%4],"compute integer golden");
  [tex release]; [output release]; [input release];
}
static void compute_case(id<MTLDevice> dev,id<MTLCommandQueue> q,id<MTLFunction> f) {
  struct WMTComputePipelineInfo i={0}; i.compute_function=(obj_handle_t)f; i.immutable_buffers=5;
  MTLComputePipelineDescriptor *d=[[MTLComputePipelineDescriptor alloc] init]; d.computeFunction=f;
  id<MTLComputePipelineState> checked=nil; NSError *error=nil;
  require(wmt_metal4_compute(dev,d,&i,&checked,&error),"Metal4 compute route selected");
  no_error(error,"Metal4 compute compile"); require(checked!=nil,"Metal4 compute compile result"); [checked release];
  struct unixcall_mtldevice_newcomputepso p={0}; p.device=(obj_handle_t)dev; p.info.ptr=&i;
  require(_MTLDevice_newComputePipelineState(&p)==STATUS_SUCCESS,"exact compute factory status");
  no_error((NSError*)p.ret_error,"exact compute factory"); require(p.ret_pso,"exact compute PSO");
  id<MTLComputePipelineState> m4=(id<MTLComputePipelineState>)p.ret_pso;
  id<MTLComputePipelineState> legacy=[dev newComputePipelineStateWithDescriptor:d options:MTLPipelineOptionNone reflection:nil error:&error];
  no_error(error,"legacy compute compile"); require(legacy!=nil,"legacy compute PSO"); [d release];
  uint32_t a[32],b[32],again[32]; dispatch_compute(dev,q,m4,a); dispatch_compute(dev,q,legacy,b); dispatch_compute(dev,q,m4,again);
  require(!memcmp(a,b,sizeof(a)),"compute Metal4/legacy byte parity"); require(!memcmp(a,again,sizeof(a)),"compute first/reuse byte parity");
  puts("PASS compute integer_golden+legacy+reuse"); [m4 release]; [legacy release];
}

/* No GPU compiler is invoked in this injected-failure receiver. Both forms of
 * failed compiler creation must stay selected and must not call legacy. */
static void mapped_function(MTL4FunctionDescriptor *d, bool specialized, NSString *name,id<MTLLibrary> lib) API_AVAILABLE(macos(26.0));
static void mapped_function(MTL4FunctionDescriptor *d, bool specialized, NSString *name,id<MTLLibrary> lib) {
  if(specialized) {
    require([d isKindOfClass:[MTL4SpecializedFunctionDescriptor class]],"mapped specialized function class");
    MTL4SpecializedFunctionDescriptor *s=(MTL4SpecializedFunctionDescriptor*)d;
    require(s.constantValues!=nil,"mapped specialized constant values present"); d=s.functionDescriptor;
  } else require([d isKindOfClass:[MTL4LibraryFunctionDescriptor class]],"mapped ordinary function class");
  require([d isKindOfClass:[MTL4LibraryFunctionDescriptor class]],"mapped base library function class");
  MTL4LibraryFunctionDescriptor *b=(MTL4LibraryFunctionDescriptor*)d;
  require(b.library==lib && [b.name isEqualToString:name],"mapped library and function name");
}
@interface DiscardedPSO : NSObject { @public unsigned *released; }
@end
@implementation DiscardedPSO
- (void)dealloc { ++*released; [super dealloc]; }
@end
@interface FailingCompiler : NSObject {
  @public BOOL supplied_error, result_with_error; unsigned *pipeline_calls, *released_results;
  const struct WMTRenderPipelineInfo *expected_render;
  MTLComputePipelineDescriptor *expected_compute; id<MTLLibrary> expected_library;
}
@end
@implementation FailingCompiler
- (id)newRenderPipelineStateWithDescriptor:(id)d compilerTaskOptions:(id)o error:(NSError**)e {
  if(@available(macOS 26.0,*)) {
  if(expected_render) {
    const struct WMTRenderPipelineInfo *i=expected_render; MTL4RenderPipelineDescriptor *p=d;
    require(o==nil,"mapped render task options");
    mapped_function(p.vertexFunctionDescriptor,false,@"vertex_main",expected_library);
    mapped_function(p.fragmentFunctionDescriptor,true,@"fragment_main",expected_library);
    for(unsigned n=0;n<31;n++) {
      require(p.vertexDescriptor.attributes[n].format==MTLVertexFormatInvalid,"mapped empty vertex attributes");
      require(p.vertexDescriptor.layouts[n].stride==0,"mapped empty vertex strides");
    }
    require(p.rasterizationEnabled==i->rasterization_enabled && p.rasterSampleCount==i->raster_sample_count,"mapped raster and samples");
    require(p.inputPrimitiveTopology==(MTLPrimitiveTopologyClass)i->input_primitive_topology,"mapped topology");
    require(p.alphaToCoverageState==(i->alpha_to_coverage_enabled ? MTL4AlphaToCoverageStateEnabled : MTL4AlphaToCoverageStateDisabled),"mapped alpha coverage");
    require(p.alphaToOneState==MTL4AlphaToOneStateDisabled,"mapped alpha to one");
    require(p.colorAttachmentMappingState==MTL4LogicalToPhysicalColorAttachmentMappingStateIdentity,"mapped color attachment identity");
    require(p.supportIndirectCommandBuffers==MTL4IndirectCommandBufferSupportStateDisabled,"mapped render indirect support");
    for(unsigned n=0;n<8;n++) {
      const struct WMTColorAttachmentBlendInfo *a=&i->colors[n]; MTL4RenderPipelineColorAttachmentDescriptor *b=p.colorAttachments[n];
      require(b.pixelFormat==to_metal_pixel_format(a->pixel_format),"mapped color format all slots");
      require(b.blendingState==(a->blending_enabled ? MTL4BlendStateEnabled : MTL4BlendStateDisabled),"mapped blend enable all slots");
      require(b.writeMask==(MTLColorWriteMask)a->write_mask,"mapped write mask all slots");
      require(b.rgbBlendOperation==(MTLBlendOperation)a->rgb_blend_operation && b.alphaBlendOperation==(MTLBlendOperation)a->alpha_blend_operation,"mapped blend operations all slots");
      require(b.sourceRGBBlendFactor==(MTLBlendFactor)a->src_rgb_blend_factor && b.destinationRGBBlendFactor==(MTLBlendFactor)a->dst_rgb_blend_factor,"mapped RGB factors all slots");
      require(b.sourceAlphaBlendFactor==(MTLBlendFactor)a->src_alpha_blend_factor && b.destinationAlphaBlendFactor==(MTLBlendFactor)a->dst_alpha_blend_factor,"mapped alpha factors all slots");
    }
  }
  } else require(!expected_render,"render mapping requires macOS 26");
  ++*pipeline_calls; if(supplied_error) *e=[NSError errorWithDomain:@"FixtureInjected" code:8 userInfo:nil];
  if(result_with_error) { DiscardedPSO *p=[DiscardedPSO new]; p->released=released_results; return p; } return nil;
}
- (id)newComputePipelineStateWithDescriptor:(id)d compilerTaskOptions:(id)o error:(NSError**)e {
  if(@available(macOS 26.0,*)) {
  if(expected_compute) {
    MTL4ComputePipelineDescriptor *p=d; require(o==nil,"mapped compute task options");
    mapped_function(p.computeFunctionDescriptor,true,@"compute_main",expected_library);
    require(p.threadGroupSizeIsMultipleOfThreadExecutionWidth==expected_compute.threadGroupSizeIsMultipleOfThreadExecutionWidth,"mapped compute thread width flag");
    require(p.maxTotalThreadsPerThreadgroup==expected_compute.maxTotalThreadsPerThreadgroup,"mapped compute maximum threads");
    require(p.supportIndirectCommandBuffers==MTL4IndirectCommandBufferSupportStateDisabled,"mapped compute indirect support");
  }
  } else require(!expected_compute,"compute mapping requires macOS 26");
  ++*pipeline_calls; if(supplied_error) *e=[NSError errorWithDomain:@"FixtureInjected" code:8 userInfo:nil];
  if(result_with_error) { DiscardedPSO *p=[DiscardedPSO new]; p->released=released_results; return p; } return nil;
}
@end
@interface FailingDevice : NSObject {
  @public unsigned legacy_calls, compiler_calls, pipeline_calls, released_results;
  BOOL supplied_error, pipeline_failure, result_with_error;
  const struct WMTRenderPipelineInfo *expected_render;
  MTLComputePipelineDescriptor *expected_compute; id<MTLLibrary> expected_library;
}
@end
@implementation FailingDevice
- (BOOL)supportsFamily:(MTLGPUFamily)family { return YES; }
- (BOOL)supportsTextureSampleCount:(NSUInteger)n { return YES; }
- (id)newCompilerWithDescriptor:(id)d error:(NSError **)error {
  compiler_calls++;
  if(pipeline_failure) { FailingCompiler *c=[FailingCompiler new];
    c->supplied_error=supplied_error; c->pipeline_calls=&pipeline_calls;
    c->result_with_error=result_with_error; c->released_results=&released_results;
    c->expected_render=expected_render; c->expected_compute=expected_compute; c->expected_library=expected_library; return c; }
  if(supplied_error) *error=[NSError errorWithDomain:@"FixtureInjected" code:7 userInfo:nil]; return nil;
}
- (id)newRenderPipelineStateWithDescriptor:(id)d options:(MTLPipelineOption)o reflection:(id*)r error:(NSError**)e {
  legacy_calls++; return nil;
}
- (id)newComputePipelineStateWithDescriptor:(id)d options:(MTLPipelineOption)o reflection:(id*)r error:(NSError**)e {
  legacy_calls++; return nil;
}
@end
static void descriptor_mapping(id<MTLLibrary> lib,id<MTLFunction> v,id<MTLFunction> f,id<MTLFunction> c) {
  FailingDevice *fake=[FailingDevice new]; fake->pipeline_failure=YES; fake->supplied_error=YES; fake->expected_library=lib;
  const enum WMTPixelFormat formats[]={WMTPixelFormatRGBA8Unorm,WMTPixelFormatBGRA8Unorm,WMTPixelFormatRGBA16Float,WMTPixelFormatRGBA32Float,
    WMTPixelFormatR32Float,WMTPixelFormatRG32Float,WMTPixelFormatR16Float,WMTPixelFormatRG16Float};
  for(unsigned n=0;n<2;n++) {
    struct WMTRenderPipelineInfo i=render_info(v,f,n ? 4 : 2,false,false);
    i.alpha_to_coverage_enabled=n; i.rasterization_enabled=n;
    i.input_primitive_topology=n ? WMTPrimitiveTopologyClassTriangle : WMTPrimitiveTopologyClassPoint;
    for(unsigned k=0;k<8;k++) {
      struct WMTColorAttachmentBlendInfo *a=&i.colors[k]; a->pixel_format=formats[k];
      a->blending_enabled=(k+n)%2; a->write_mask=(enum WMTColorWriteMask)((k*3+n)&15);
      a->rgb_blend_operation=(enum WMTBlendOperation)(k%5); a->alpha_blend_operation=(enum WMTBlendOperation)((k+2)%5);
      a->src_rgb_blend_factor=(enum WMTBlendFactor)k; a->dst_rgb_blend_factor=(enum WMTBlendFactor)(k+1);
      a->src_alpha_blend_factor=(enum WMTBlendFactor)(k+2); a->dst_alpha_blend_factor=(enum WMTBlendFactor)(k+3);
    }
    fake->expected_render=&i; struct unixcall_mtldevice_newrenderpso r={0}; r.device=(obj_handle_t)fake; r.info.ptr=&i;
    _MTLDevice_newRenderPipelineState(&r); require(!r.ret_pso && r.ret_error,"mapped render rejected by fixture compiler"); fake->expected_render=NULL;
    struct WMTComputePipelineInfo ci={0}; ci.compute_function=(obj_handle_t)c; ci.tgsize_is_multiple_of_sgwidth=n;
    MTLComputePipelineDescriptor *d=[[MTLComputePipelineDescriptor alloc] init]; d.computeFunction=c; d.threadGroupSizeIsMultipleOfThreadExecutionWidth=n;
    fake->expected_compute=d; struct unixcall_mtldevice_newcomputepso p={0}; p.device=(obj_handle_t)fake; p.info.ptr=&ci;
    _MTLDevice_newComputePipelineState(&p); require(!p.ret_pso && p.ret_error,"mapped compute rejected by fixture compiler");
    d.maxTotalThreadsPerThreadgroup=64; id<MTLComputePipelineState> cp=nil; NSError *e=nil;
    require(wmt_metal4_compute((id<MTLDevice>)fake,d,&ci,&cp,&e) && !cp && e,"mapped direct compute maximum threads");
    fake->expected_compute=nil; [d release];
  }
  require(fake->pipeline_calls==6 && fake->legacy_calls==0,"descriptor mapping exercised exact factories without fallback"); [fake release];
  puts("PASS CPU mapping eight_color_slots+ops+factors+masks+raster+samples+topology+alpha+function_recipes+compute_flags");
}
static void routing(id<MTLDevice> dev,id<MTLLibrary> lib,id<MTLFunction> v,id<MTLFunction> f,id<MTLFunction> c) {
  struct WMTRenderPipelineInfo ri=render_info(v,f,1,false,false);
  MTLRenderPipelineDescriptor *rd=render_desc(ri); id<MTLRenderPipelineState> rp=nil; NSError *e=nil;
  rd.vertexFunction=nil;
  require(wmt_metal4_render(dev,rd,&ri,&rp,&e) && !rp && e,"missing vertex selected error");
  rd.vertexFunction=v; rd.fragmentFunction=nil; e=nil;
  require(!wmt_metal4_render(dev,rd,&ri,&rp,&e),"missing fragment preserves legacy depth-only route");
  rd.fragmentFunction=f; rd.vertexFunction=c; e=nil;
  require(wmt_metal4_render(dev,rd,&ri,&rp,&e) && !rp && e,"wrong render stage selected error");
  rd.vertexFunction=v; rd.rasterSampleCount=3; e=nil;
  require(![dev supportsTextureSampleCount:3],"negative sample count precondition");
  require(wmt_metal4_render(dev,rd,&ri,&rp,&e) && !rp && e,"unsupported sample count selected error");
  rd.rasterSampleCount=1;
  id<MTLFunction> untracked=[lib newFunctionWithName:@"vertex_raw"]; rd.vertexFunction=untracked; e=nil;
  require(untracked!=nil,"untracked function allocation");
  require(!wmt_metal4_render(dev,rd,&ri,&rp,&e),"missing provenance legacy route");
  [untracked release]; rd.vertexFunction=v;
  for(unsigned n=0;n<7;n++) {
    struct WMTRenderPipelineInfo blocked=ri;
    if(n==0) blocked.logic_operation_enabled=true;
    if(n==1) blocked.support_indirect_command_buffers=true;
    if(n==2) blocked.num_binary_archives_for_lookup=1;
    if(n==3) blocked.binary_archive_for_serialization=1;
    if(n==4) blocked.fail_on_binary_archive_miss=true;
    if(n==5) blocked.depth_pixel_format=WMTPixelFormatDepth16Unorm;
    if(n==6) blocked.stencil_pixel_format=WMTPixelFormatStencil8;
    require(!wmt_metal4_render(dev,rd,&blocked,&rp,&e),"unsupported render recipe legacy route");
  }
  struct WMTComputePipelineInfo ci={0}; ci.compute_function=(obj_handle_t)c;
  MTLComputePipelineDescriptor *cd=[[MTLComputePipelineDescriptor alloc] init]; id<MTLComputePipelineState> cp=nil;
  e=nil; require(wmt_metal4_compute(dev,cd,&ci,&cp,&e) && !cp && e,"missing compute selected error");
  cd.computeFunction=v; e=nil;
  require(wmt_metal4_compute(dev,cd,&ci,&cp,&e) && !cp && e,"wrong compute stage selected error");
  cd.computeFunction=c;
  for(unsigned n=0;n<4;n++) {
    struct WMTComputePipelineInfo blocked=ci;
    if(n==0) blocked.support_indirect_command_buffers=true;
    if(n==1) blocked.num_binary_archives_for_lookup=1;
    if(n==2) blocked.binary_archive_for_serialization=1;
    if(n==3) blocked.fail_on_binary_archive_miss=true;
    require(!wmt_metal4_compute(dev,cd,&blocked,&cp,&e),"unsupported compute recipe legacy route");
  }
  for(unsigned n=0;n<5;n++) {
    FailingDevice *fake=[FailingDevice new]; fake->supplied_error=n==4 || n%2;
    fake->pipeline_failure=n>=2; fake->result_with_error=n==4;
    struct unixcall_mtldevice_newrenderpso r={0}; r.device=(obj_handle_t)fake; r.info.ptr=&ri;
    _MTLDevice_newRenderPipelineState(&r); require(!r.ret_pso && r.ret_error,"compiler failure render output");
    require([[(NSError*)r.ret_error domain] isEqualToString:fake->supplied_error ? @"FixtureInjected" : @"DXMTMetal4Compiler"],"compiler failure render NSError");
    struct unixcall_mtldevice_newcomputepso p={0}; p.device=(obj_handle_t)fake; p.info.ptr=&ci;
    _MTLDevice_newComputePipelineState(&p); require(!p.ret_pso && p.ret_error,"compiler failure compute output");
    require([[(NSError*)p.ret_error domain] isEqualToString:fake->supplied_error ? @"FixtureInjected" : @"DXMTMetal4Compiler"],"compiler failure compute NSError");
    require(fake->compiler_calls==2 && fake->legacy_calls==0,"selected compiler failure never falls back");
    require(fake->pipeline_calls==(fake->pipeline_failure ? 2 : 0),"injected pipeline failure exercised");
    require(fake->released_results==(fake->result_with_error ? 2 : 0),"result plus NSError releases discarded PSOs"); [fake release];
  }
  [cd release]; [rd release]; puts("PASS routing missing_required+stage+sample+provenance+archives+logic+ICB+depth_stencil+compiler_failure");
}
static void pso_lifetime(id<MTLDevice> dev,id<MTLCommandQueue> q) {
  id<MTLRenderPipelineState> rp=nil; id<MTLComputePipelineState> cp=nil;
  @autoreleasepool {
    NSError *e=nil; id<MTLLibrary> lib=[dev newLibraryWithSource:source options:nil error:&e];
    no_error(e,"lifetime library"); require(lib!=nil,"lifetime library result");
    id<MTLFunction> v=ordinary(lib,"vertex_main"); float gain=0.5f; uint32_t mul=3;
    id<MTLFunction> f=specialized(lib,"fragment_main",&gain,(enum WMTDataType)MTLDataTypeFloat,0);
    id<MTLFunction> c=specialized(lib,"compute_main",&mul,(enum WMTDataType)MTLDataTypeUInt,1);
    struct WMTRenderPipelineInfo ri=render_info(v,f,1,false,false); rp=native_render(dev,&ri);
    struct WMTComputePipelineInfo ci={0}; ci.compute_function=(obj_handle_t)c;
    struct unixcall_mtldevice_newcomputepso p={0}; p.device=(obj_handle_t)dev; p.info.ptr=&ci;
    _MTLDevice_newComputePipelineState(&p); no_error((NSError*)p.ret_error,"lifetime compute compile");
    require(p.ret_pso,"lifetime compute PSO"); cp=(id<MTLComputePipelineState>)p.ret_pso;
    [v release]; [f release]; [c release]; [lib release];
  } /* Drain temporary Metal4 descriptors and function recipes before execution. */
  unsigned char a[PIXEL_BYTES],again[PIXEL_BYTES]; const unsigned char expected[]={32,64,96,64};
  draw(dev,q,rp,1,false,a); draw(dev,q,rp,1,false,again); golden(a,expected,"PSO-only lifetime golden");
  require(!memcmp(a,again,sizeof(a)),"PSO-only render reuse");
  uint32_t x[32],y[32]; dispatch_compute(dev,q,cp,x); dispatch_compute(dev,q,cp,y);
  require(!memcmp(x,y,sizeof(x)),"PSO-only compute reuse"); [rp release]; [cp release];
  puts("PASS PSO-only retained lifetime after function+library release and autorelease drain");
}
#include "translated.inc"
#include "cost.inc"
int main(int argc,char **argv) { @autoreleasepool {
  if(argc==3 && !strcmp(argv[1],"--translated-dir")) return translated_all(argv[2]);
  if(argc==3 && !strcmp(argv[1],"--cost-dir")) return cost_all(argv[2]);
  require(argc==1 || (argc==2 && !strcmp(argv[1],"--probe-depth")),"usage: fixture [--probe-depth]");
  id<MTLDevice> dev=MTLCreateSystemDefaultDevice();
  if(!dev || !wmt_metal4_capable(dev)) { puts("SKIP Metal4 device/runtime opt-in unavailable"); [dev release]; return 77; }
  id<MTLCommandQueue> q=[dev newCommandQueue]; require(q!=nil,"command queue");
  pso_lifetime(dev,q); /* Run before other factory objects enter the outer pool. */
  NSError *error=nil; id<MTLLibrary> lib=[dev newLibraryWithSource:source options:nil error:&error];
  no_error(error,"fixture MSL compile"); require(lib!=nil,"fixture library");
  id<MTLFunction> v=ordinary(lib,"vertex_main"); float gain=0.5f; uint32_t mul=3;
  id<MTLFunction> f=specialized(lib,"fragment_main",&gain,(enum WMTDataType)MTLDataTypeFloat,0);
  id<MTLFunction> c=specialized(lib,"compute_main",&mul,(enum WMTDataType)MTLDataTypeUInt,1);
  gain=9; mul=99; /* Factory must have copied the caller-owned constant bytes. */
  descriptor_mapping(lib,v,f,c); routing(dev,lib,v,f,c); [lib release]; lib=nil;
  /* Factories' retained provenance is the remaining library owner here. */
  compute_case(dev,q,c); render_case(dev,q,v,f,1,false,false,false);
  render_case(dev,q,v,f,1,true,false,false); render_case(dev,q,v,f,1,true,true,false);
  require([dev supportsTextureSampleCount:4],"4x MSAA required by bounded fixture");
  render_case(dev,q,v,f,4,true,true,false);
  if(argc==2) render_case(dev,q,v,f,1,false,false,true);
  [c release]; [f release]; [v release]; [q release]; [dev release];
  puts("PASS native exact factories and production Metal4 helper; no performance or game claim"); return 0;
} }
