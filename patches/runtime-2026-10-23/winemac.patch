+static double w7vis_now(void)
+{
+    struct timespec t;
+    if (clock_gettime(CLOCK_MONOTONIC_RAW, &t)) return -1.0;
+    return t.tv_sec + t.tv_nsec / 1e9;
+}
+
+static NSArray *w7vis_rect(CGRect r)
+{
+    return @[@(r.origin.x), @(r.origin.y), @(r.size.width), @(r.size.height)];
