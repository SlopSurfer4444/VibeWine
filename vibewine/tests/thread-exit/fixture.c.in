/* The exit, EOF and pthread cleanup bodies below are extracted without edits. */
#define _DARWIN_C_SOURCE
#define _GNU_SOURCE
#define _POSIX_C_SOURCE 200809L
#include <errno.h>
#include <fcntl.h>
#include <pthread.h>
#include <signal.h>
#include <stdint.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>

#define DECLSPEC_NORETURN __attribute__((noreturn))
#define UIntToPtr(value) ((void *)(uintptr_t)(unsigned int)(value))
typedef int32_t LONG;
typedef uint32_t NTSTATUS;
struct ntdll_thread_data { int alert_fd, wait_fd[2], reply_fd, request_fd; pthread_t pthread_id; };
typedef struct { struct ntdll_thread_data GdiTebBatch; } TEB;
static _Thread_local struct ntdll_thread_data thread_data;
static _Thread_local TEB teb;
static _Thread_local unsigned int role, close_count;
static unsigned int signal_close, normal_exit;
static sigset_t server_block_set;
static LONG nb_threads = 1;

struct event { uint32_t type, role; int32_t value; uint32_t extra; };
static void event(unsigned int type, int value, unsigned int extra)
{
    struct event record = { type, role, value, extra };
    if (write(STDOUT_FILENO, &record, sizeof(record)) != sizeof(record)) _exit(91);
}
static LONG InterlockedDecrement(LONG *value)
{
    LONG result = __atomic_sub_fetch(value, 1, __ATOMIC_SEQ_CST);
    event(1, result, 0);
    return result;
}
static struct ntdll_thread_data *ntdll_get_thread_data(void) { return &thread_data; }
/* This fixture owns five real Unix fds; MSync indices have a separate fixture. */
static int do_msync(void) { return 0; }
static TEB *NtCurrentTeb(void) { return &teb; }
static void *InterlockedExchangePointer(void **target, void *value)
{
    return __atomic_exchange_n(target, value, __ATOMIC_SEQ_CST);
}
static void virtual_free_teb(TEB *old_teb)
{
    (void)old_teb;
    _exit(90); /* The first normal exit has no previous TEB to retire. */
}
static DECLSPEC_NORETURN void fixture_exit(int status)
{
    event(4, status, 0);
    _exit(status);
}
static int fixture_close(int fd)
{
    sigset_t current;
    unsigned int missing = 0;
    int signal;
    int result = close(fd);

    if (!close_count)
    {
        if (pthread_sigmask(SIG_SETMASK, NULL, &current)) _exit(99);
        for (signal = 1; signal < NSIG; ++signal)
            if (sigismember(&server_block_set, signal) == 1 && sigismember(&current, signal) != 1)
                ++missing;
        event(7, sigismember(&current, SIGQUIT), missing);
    }
    event(2, result, ++close_count);
    /* A real, thread-directed signal at an actual cleanup syscall boundary. */
    if (role == 1 && close_count == signal_close)
    {
        event(5, SIGQUIT, close_count);
        if (raise(SIGQUIT)) _exit(92);
    }
    return result;
}
static DECLSPEC_NORETURN void server_protocol_perror(const char *where)
{
    (void)where;
    _exit(93);
}
void abort_thread(int status) DECLSPEC_NORETURN;
void abort_process(int status) DECLSPEC_NORETURN;
void exit_process(int status) DECLSPEC_NORETURN;
static DECLSPEC_NORETURN void process_exit_wrapper(int status) { fixture_exit(status); }

/* PRODUCTION_UNIX_EXIT_CODE */
/* PRODUCTION_BLOCK_EXIT_SIGNALS */
#define close fixture_close
/* PRODUCTION_PTHREAD_EXIT_WRAPPER */
#undef close
/* PRODUCTION_ABORT_THREAD */
#define _exit fixture_exit
/* PRODUCTION_ABORT_PROCESS */
#undef _exit
/* PRODUCTION_EXIT_PROCESS */
/* PRODUCTION_EXIT_THREAD */
/* PRODUCTION_READ_REPLY_DATA */

static void quit_handler(int signal)
{
    event(3, signal, 0);
    abort_thread(0);
}
static void *worker(void *unused)
{
    char value;
    thread_data = *(struct ntdll_thread_data *)unused;
    thread_data.pthread_id = pthread_self();
    teb.GdiTebBatch = thread_data;
    role = 1;
    if (signal_close == 6 && raise(SIGQUIT)) _exit(92);
    if (normal_exit) exit_thread(7);
    read_reply_data(&value, sizeof(value));
    _exit(94);
}
int main(int argc, char **argv)
{
    struct sigaction action;
    pthread_t thread;
    void *status;
    int reply[2], fds[5], i;
    sigset_t current;
    if (argc != 3 || sizeof(struct event) != 16) return 95;
    signal_close = (unsigned int)strtoul(argv[1], NULL, 10);
    if (!strcmp(argv[2], "normal")) normal_exit = 1;
    else if (strcmp(argv[2], "abort")) return 95;
    if (signal_close > 6) return 95;
    /* PRODUCTION_SERVER_BLOCK_SET */
    memset(&action, 0, sizeof(action));
    action.sa_handler = quit_handler;
    action.sa_mask = server_block_set;
    if (sigaction(SIGQUIT, &action, NULL)) return 96;
    if (pipe(reply)) return 96;
    if (close(reply[1])) return 96;
    fds[0] = open("/dev/null", O_RDONLY);
    fds[1] = open("/dev/null", O_RDONLY);
    fds[2] = open("/dev/null", O_RDONLY);
    fds[3] = reply[0];
    fds[4] = open("/dev/null", O_RDONLY);
    for (i = 0; i < 5; ++i) if (fds[i] < 0) return 96;
    /* TLS data is copied by the worker before the actual production EOF path. */
    thread_data.alert_fd = fds[0];
    thread_data.wait_fd[0] = fds[1];
    thread_data.wait_fd[1] = fds[2];
    thread_data.reply_fd = fds[3];
    thread_data.request_fd = fds[4];
    __atomic_add_fetch(&nb_threads, 1, __ATOMIC_SEQ_CST);
    if (pthread_create(&thread, NULL, worker, &thread_data)) return 96;
    if (pthread_join(thread, &status) || status != UIntToPtr(normal_exit && signal_close != 6 ? 7 : 0)) return 97;
    if (pthread_sigmask(SIG_SETMASK, NULL, &current)) return 99;
    event(8, sigismember(&current, SIGQUIT), 0);
    for (i = 0; i < 5; ++i)
    {
        errno = 0;
        if (fcntl(fds[i], F_GETFD) != -1 || errno != EBADF) return 98;
    }
    event(6, 0, 5);
    abort_thread(20);
}
