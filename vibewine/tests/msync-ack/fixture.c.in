#include <assert.h>
#include <errno.h>
#include <setjmp.h>
#include <signal.h>
#include <stdint.h>
enum { MSYNC_ATTR_REGISTER_SEND, MSYNC_ATTR_UNREGISTER_SEND, MSYNC_ATTR_SIGNAL_SEND, MSYNC_ATTR_ACK };
static uint64_t msync_attribution_begin(unsigned int kind) { return 0; }
static void msync_attribution_end(unsigned int kind,uint64_t start,int status) {}

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#define MAXIMUM_WAIT_OBJECTS 64
#define MACH_MSG_SUCCESS 0
#define MACH_SEND_MSG 1
#define MACH_PORT_NULL 0
#define MACH_MSG_TIMEOUT_NONE 0
#define MSYNC_MUTEX 3
#define STATUS_PENDING 0x103
#define STATUS_TIMEOUT 0x102
#define STATUS_SUCCESS 0
#define UL_COMPARE_AND_WAIT_SHARED 3
#define ULF_NO_ERRNO 0x1000000
#define ERR(...) do {} while (0)
#define pthread_sigmask(...) 0
#define max(a,b) ((a) > (b) ? (a) : (b))
#define KERN_INVALID_NAME 15
#define KERN_SUCCESS 0
#define MACH_PORT_TYPE_DEAD_NAME 16
typedef unsigned int mach_port_type_t;
typedef int kern_return_t;
typedef int NTSTATUS;
typedef unsigned long long ULONGLONG;
typedef int mach_msg_return_t;
typedef struct { unsigned int msgh_remote_port,msgh_bits,msgh_id,msgh_size; } mach_msg_header_t;
typedef struct { mach_msg_header_t header; unsigned int shm_idx[65]; } mach_register_message_t;
typedef struct { mach_msg_header_t header; int entry; } mach_map_message_t;
struct event { int signaled,unused; unsigned short msync_type,refcount; int multiple_waiters; };
struct mutex { int tid,count; unsigned short msync_type,refcount; int multiple_waiters; };
struct msync_shm { int low,high; unsigned short msync_type,refcount; int multiple_waiters; };
struct tid_node { int tid; struct tid_node *next; };
struct tid_list { struct tid_node *head; };
static struct tid_list *tid_map;
static size_t tid_map_size;
static int states[128], *shm_tid_map=states;
static int server_port=9, msgh_bits_send=0;
static struct event objects[8];
static int nodes, sends, qread, qwrite, ack_loads, capped, parks, normal_parks;
static int wakes, wake_interrupts, wake_attempts, dead_server, death_checks, aborted;
static int scenario;
static ULONGLONG now;
static uint64_t normal_timeout;
static mach_register_message_t queue[128];
static jmp_buf drained, died;
enum { EARLY_ACK, PARKED_ACK, CAS_RACE, DELAYED, DEADLINE, INTERRUPT, FAULT,
       SPURIOUS, ALERT, BAD_WAIT, DEAD_BEFORE, DEAD_AFTER, OBJECT_READY, DEAD_SEND, MISMATCH, FINITE_ACK };
static void drain(void);
static struct tid_node *pool_alloc(void) { ++nodes; return calloc(1,sizeof(struct tid_node)); }
static void pool_free(struct tid_node *p) { --nodes; free(p); }
static void *get_shm(unsigned int i) { assert(i<8); return &objects[i]; }
static void send_shm_to_client(mach_map_message_t *m) { abort(); }
static void destroy_all_internal(unsigned int i) { abort(); }
static long long update_timeout(ULONGLONG end) { return end > now ? end-now : 0; }
static int ulock_wait(uint32_t op,void *addr,uint64_t value,uint64_t timeout);
static int mach_task_self(void) { return 1; }
static int mach_port_type(int task,int port,mach_port_type_t *type) {
    ++death_checks; *type=dead_server ? MACH_PORT_TYPE_DEAD_NAME : 1; return 0;
}
static void abort_thread(int status) { ++aborted; longjmp(died,1); }
static int __ulock_wake(uint32_t op,void *addr,uint64_t value) {
    ++wake_attempts;
    if(wake_interrupts) { --wake_interrupts; errno=EINTR; return -1; }
    ++wakes; return 0;
}
static int mach_msg2(mach_msg_header_t *m,int options,int send,int recv,int port,int timeout,int priority) {
    if(scenario==DEAD_SEND) { ++sends; dead_server=1; return 1; }
    assert(qwrite<128); memset(&queue[qwrite],0,sizeof(queue[qwrite]));
    memcpy(&queue[qwrite++],m,send); queue[qwrite-1].header.msgh_remote_port=0;
    ++sends; return 0;
}
static int receive_mach_msg(mach_register_message_t *out) {
    if(qread==qwrite) longjmp(drained,1);
    *out=queue[qread++]; return 0;
}
static int fixture_load(int *addr,int order) {
    if(addr==states+7 && __atomic_load_n(addr,order)==2) {
        ++ack_loads;
        if(scenario==EARLY_ACK && ack_loads==4) drain();
        if(scenario==CAS_RACE && ack_loads==4097) drain();
        if(scenario==OBJECT_READY && ack_loads==4) objects[2].signaled=1;
        /* A baseline busy loop is released by this observation seam, not admitted
         * as a timeout/crash. Each affected assertion requires this cap untouched. */
        if(ack_loads==8193) { ++capped; __atomic_store_n(addr,1,__ATOMIC_RELEASE); }
    }
    return __atomic_load_n(addr,order);
}
#define __atomic_load_n(addr,order) fixture_load((int *)(addr),order)

/* PRODUCTION_ACK_CONSTANTS */
/* PRODUCTION_CLIENT */
/* PRODUCTION_SERVER */

static void drain(void) { if(!setjmp(drained)) mach_message_pump(NULL); qread=qwrite=0; }
static int ulock_wait(uint32_t op,void *addr,uint64_t value,uint64_t timeout) {
    assert(op==(UL_COMPARE_AND_WAIT_SHARED|ULF_NO_ERRNO));
    assert(addr==states+7);
    if(value==3) {
        ++parks;
        assert(timeout && timeout<=10000000);
        if(scenario==DELAYED && parks<=3) return -ETIMEDOUT;
        if(scenario==DEADLINE) { now=100; return -ETIMEDOUT; }
        if(scenario==INTERRUPT && parks==1) return -EINTR;
        if(scenario==FAULT && parks==1) return -EFAULT;
        if(scenario==SPURIOUS && parks==1) return 0;
        if(scenario==MISMATCH && parks==1) return -EAGAIN;
        if(scenario==ALERT) { objects[3].signaled=1; return -EINTR; }
        if(scenario==BAD_WAIT) return -EINVAL;
        if(scenario==DEAD_AFTER) { dead_server=1; return -ETIMEDOUT; }
        drain();
        return 0;
    }
    ++normal_parks;
    assert(value==1);
    normal_timeout=timeout;
    if(scenario==PARKED_ACK && timeout) return -ETIMEDOUT;
    /* Signal after registration, using the actual pump's normal wake path. */
    drain(); signal_all_internal(1);
    return 0;
}
static void reset(int next) {
    for(size_t i=0;i<tid_map_size;i++) while(tid_map[i].head) remove_tid(i,tid_map[i].head->tid);
    memset(objects,0,sizeof(objects)); memset(states,0,sizeof(states));
    sends=qread=qwrite=ack_loads=capped=parks=normal_parks=wakes=wake_interrupts=0;
    wake_attempts=dead_server=death_checks=aborted=0; now=normal_timeout=0; scenario=next;
}
static int balanced(void) { return nodes==0 && !objects[1].multiple_waiters
    && !objects[2].multiple_waiters && !objects[3].multiple_waiters; }
static int fail,checks;
#define CHECK(cond,name) do { ++checks; if(!(cond)) { fprintf(stderr,"FAIL %s\n",name); ++fail; } }while(0)
static NTSTATUS wait_case(ULONGLONG *end) {
    int ids[]={1,2}; void *shm[]={&objects[1],&objects[2]};
    return msync_wait_multiple(ids,shm,3,&objects[3],2,end,7);
}
int main(void) {
    NTSTATUS status; ULONGLONG end=50;
    reset(EARLY_ACK); status=wait_case(NULL); drain();
    CHECK(status==STATUS_SUCCESS && !parks && !capped && balanced(),"ack during spin control");
    reset(PARKED_ACK); wake_interrupts=1; status=wait_case(NULL); drain();
    CHECK(status==STATUS_SUCCESS && parks==1 && !capped && balanced(),"park before ack");
    CHECK(!normal_timeout,"ACK slice never limits infinite object wait");
    CHECK(wake_attempts==wakes+1 && wakes>=1,"interrupted ack wake is retried");
    reset(FINITE_ACK); status=wait_case(&end); drain();
    CHECK(status==STATUS_SUCCESS && parks==1 && !capped && normal_timeout==5000 && balanced(),"finite deadline preserved after ack");
    reset(CAS_RACE); status=wait_case(NULL); drain();
    CHECK(status==STATUS_SUCCESS && parks==0 && !capped && balanced(),"ack between load and arm control");
    reset(DELAYED); status=wait_case(NULL); drain();
    CHECK(status==STATUS_SUCCESS && parks==4 && !capped && balanced(),"delayed ack slices are not object timeout");
    reset(DEADLINE); status=wait_case(&end); drain();
    CHECK(status==STATUS_TIMEOUT && parks==1 && !capped && sends==2 && balanced(),"deadline while ack pending");
    reset(DEADLINE); end=0; status=wait_case(&end); drain();
    CHECK(status==STATUS_TIMEOUT && !parks && !capped && sends==2 && balanced(),"expired deadline while ack pending");
    reset(INTERRUPT); status=wait_case(NULL); drain();
    CHECK(status==STATUS_SUCCESS && parks==2 && !capped && sends==2 && balanced(),"interrupted ack park retries without unregister");
    reset(FAULT); status=wait_case(NULL); drain();
    CHECK(status==STATUS_SUCCESS && parks==2 && !capped && sends==2 && balanced(),"faulted ack park rechecks");
    reset(SPURIOUS); status=wait_case(NULL); drain();
    CHECK(status==STATUS_SUCCESS && parks==2 && !capped && balanced(),"spurious ack wake rechecks state");
    reset(MISMATCH); status=wait_case(NULL); drain();
    CHECK(status==STATUS_SUCCESS && parks==2 && !capped && balanced(),"compare mismatch rechecks ack state");
    reset(ALERT); status=wait_case(NULL); objects[3].signaled=0; drain();
    CHECK(status==STATUS_PENDING && parks==1 && !capped && sends==2 && balanced(),"alert cancels parked registration once");
    reset(BAD_WAIT); status=wait_case(NULL); drain();
    CHECK(status==STATUS_PENDING && parks==1 && !capped && sends==2 && balanced(),"unexpected ack park failure cleans registration");
    reset(OBJECT_READY); status=wait_case(NULL); objects[2].signaled=0; drain();
    CHECK(status==STATUS_PENDING && !parks && sends==2 && balanced(),"ready object preserves early unregister control");
    reset(DEAD_BEFORE); dead_server=1;
    if(!setjmp(died)) wait_case(NULL);
    CHECK(aborted==1 && death_checks==1 && !parks && sends==1 && !capped,"dead server before ack park aborts thread");
    reset(DEAD_AFTER);
    if(!setjmp(died)) wait_case(NULL);
    CHECK(aborted==1 && death_checks==2 && parks==1 && sends==1 && !capped,"dead server after ack park aborts thread");
    reset(DEAD_SEND);
    if(!setjmp(died)) wait_case(NULL);
    CHECK(aborted==1 && death_checks==1 && !parks && sends==1 && !qwrite,"dead server during registration aborts thread");
    reset(EARLY_ACK); free(tid_map);
    printf("checks=%d failed=%d\n",checks,fail); return fail?1:0;
}
